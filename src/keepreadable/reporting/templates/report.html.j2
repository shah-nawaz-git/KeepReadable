<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>KeepReadable Audit Report — {{ data.archive_name }}</title>
<style>
:root { --bg:#F5F7FA; --surface:#FFFFFF; --border:#D9DEE5; --text:#1F2933; --muted:#52606D; --accent:#2F6FED; --healthy:#1E8E5A; --review:#B7791F; --unreadable:#C53030; --unknown:#6B7280; }
* { box-sizing:border-box; }
body { margin:0; background:var(--bg); color:var(--text); font:14px/1.5 "Segoe UI",Arial,sans-serif; }
main { max-width:1100px; margin:0 auto; padding:32px; }
h1 { margin:0 0 4px; font-size:28px; } h2 { margin-top:28px; font-size:19px; }
.muted { color:var(--muted); } .card { background:var(--surface); border:1px solid var(--border); border-radius:8px; padding:18px; margin:12px 0; }
.grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(145px,1fr)); gap:12px; }
.stat strong { display:block; font-size:22px; } table { width:100%; border-collapse:collapse; background:white; }
th,td { border-bottom:1px solid var(--border); padding:9px; text-align:left; vertical-align:top; overflow-wrap:anywhere; }
th { background:#E3ECFD; } .high { color:var(--unreadable); font-weight:700; } .medium { color:var(--review); font-weight:700; } .low,.info { color:#4A5568; font-weight:600; }
ul { padding-left:22px; } footer { margin-top:30px; color:var(--muted); font-size:12px; }
</style>
</head>
<body><main>
<h1>KeepReadable Audit Report</h1>
<div class="muted">{{ data.archive_name }} · {{ data.root_path }}</div>
<div class="card grid">
<div class="stat"><span>Mode</span><strong>{{ data.mode_label }}</strong></div>
<div class="stat"><span>Processed</span><strong>{{ "{:,}".format(data.counts.files_processed) }}</strong></div>
<div class="stat"><span>Findings</span><strong>{{ "{:,}".format(data.findings|length) }}</strong></div>
<div class="stat"><span>Coverage</span><strong>{{ "{:.0f}".format(data.coverage[2]) }} %</strong></div>
</div>
<h2>Audit evidence</h2>
<table><tbody>
<tr><th>Started</th><td>{{ data.run.started_at.strftime("%Y-%m-%d %H:%M") }}</td></tr>
<tr><th>Policy version</th><td>{{ data.policy_version }}</td></tr>
<tr><th>Signature identifiers</th><td>{{ data.signature_version or "Unavailable" }}</td></tr>
{% for name, version in data.tool_versions|dictsort %}<tr><th>{{ name|title }}</th><td>{{ version }}</td></tr>{% endfor %}
</tbody></table>
<h2>Results</h2>
<div class="card grid">
<div class="stat"><span>Healthy</span><strong>{{ data.counts.healthy }}</strong></div>
<div class="stat"><span>Review</span><strong>{{ data.counts.review }}</strong></div>
<div class="stat"><span>Unreadable</span><strong>{{ data.counts.unreadable }}</strong></div>
<div class="stat"><span>Unknown</span><strong>{{ data.counts.unknown }}</strong></div>
<div class="stat"><span>Protected</span><strong>{{ data.counts.protected }}</strong></div>
<div class="stat"><span>Unexpected checksum changes</span><strong>{{ data.counts.unexpected_changes }}</strong></div>
</div>
<h2>Findings</h2>
<table><thead><tr><th>Severity</th><th>Finding</th><th>Path</th><th>Evidence</th></tr></thead><tbody>
{% for finding in data.findings %}<tr><td class="{{ finding.severity }}">{{ finding.severity|title }}</td><td><strong>{{ finding.title }}</strong><br>{{ finding.description|replace("\n\n", " ") }}</td><td>{{ finding.relative_path or "Archive-level" }}</td><td>{% for key,value in finding.evidence.items() %}<strong>{{ key|replace("_"," ")|title }}:</strong> {{ value }}<br>{% endfor %}</td></tr>{% endfor %}
{% if not data.findings %}<tr><td colspan="4">No findings were recorded for this run.</td></tr>{% endif %}
{% if data.findings_more_count %}<tr><td colspan="4">and {{ data.findings_more_count }} more findings</td></tr>{% endif %}
</tbody></table>
<h2>Compatibility copies</h2>
<table><thead><tr><th>Source</th><th>Output</th><th>Operation</th><th>Verification</th></tr></thead><tbody>
{% for item in data.generated_copies %}<tr><td>{{ item.source_path }}</td><td>{{ item.output_path or "No output retained" }}</td><td>{{ item.operation|replace("_"," ")|title }}</td><td>{{ item.verification_status|title }}</td></tr>{% endfor %}
{% if not data.generated_copies %}<tr><td colspan="4">No compatibility copies are recorded for this archive.</td></tr>{% endif %}
</tbody></table>
<h2>Limitations</h2><div class="card"><ul>{% for limitation in data.limitations %}<li>{{ limitation }}</li>{% endfor %}</ul></div>
{% if data.skipped_summary %}<h2>Skipped items</h2><div class="card"><ul>{% for reason,count in data.skipped_summary.items() %}<li>{{ reason|replace("_"," ")|title }}: {{ count }}</li>{% endfor %}</ul></div>{% endif %}
<footer>Generated by KeepReadable {{ data.generated_at.strftime("%Y-%m-%d %H:%M") }}</footer>
</main></body></html>
